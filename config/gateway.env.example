# DJUA_SMS temporary Windows test configuration.
# setup_windows_test.bat copies this file to config/gateway.env.
# config/gateway.env is ignored by Git so production secrets stay local.

DATABASE_PATH=data/djua_sms_gateway.db
GATEWAY_LOG_PATH=logs/gateway.log
GATEWAY_LOG_LEVEL=INFO
GATEWAY_STOP_FILE=data/gateway.stop

# SIM868 receiver. COM16 matches the current test workstation; change it if
# Windows assigns another COM port.
SERIAL_PORT=COM16
SERIAL_BAUD_RATE=9600
SERIAL_TIMEOUT_SECONDS=0.5
SERIAL_WRITE_TIMEOUT_SECONDS=2
GSM_INIT_RETRIES=3
GSM_COMMAND_TIMEOUT_SECONDS=5
GSM_RECONNECT_SECONDS=5
GSM_SMS_STORAGE=SM
GSM_CNMI=2,1,0,0,0

# Temporary test mode. AUTH=- is accepted only in development.
D2_AUTH_MODE=development
D2_HMAC_KEYS_JSON={}
D2_SENDER_BINDINGS_JSON={}

# Output selection:
# MQTT_ONLY      -> current behavior, only MQTT outbox/publisher
# HTTP_ONLY      -> only persistent HTTP POST delivery
# MQTT_AND_HTTP  -> create both outboxes from the same normalized payload
DELIVERY_MODE=MQTT_ONLY

# Required only when DELIVERY_MODE includes HTTP.
# HTTP_EVENT_URL is optional; when empty, events use HTTP_BACKEND_URL too.
HTTP_BACKEND_URL=
HTTP_EVENT_URL=
HTTP_TIMEOUT_SECONDS=10
HTTP_RETRY_BASE_SECONDS=2
HTTP_RETRY_MAX_SECONDS=300
HTTP_API_KEY_HEADER=x-device-token
HTTP_API_KEY=

# Required only when DELIVERY_MODE includes MQTT.
# Replace MQTT_HOST before setup can finish successfully in MQTT modes.
MQTT_HOST=CHANGE_ME
MQTT_PORT=1883
MQTT_CLIENT_ID=djua-sms-gateway-001
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=djua/test
MQTT_QOS=1
MQTT_RETAIN=false
MQTT_KEEPALIVE_SECONDS=60
MQTT_CONNECT_TIMEOUT_SECONDS=10
MQTT_PUBLISH_TIMEOUT_SECONDS=10
MQTT_RETRY_BASE_SECONDS=2
MQTT_RETRY_MAX_SECONDS=300
MQTT_TLS=false
